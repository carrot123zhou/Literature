{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Literature",
  "version": "0.1.0",
  "identifier": "local.literature.workbench",
  "build": {
    "beforeDevCommand": "cd frontend && pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "cd frontend && pnpm build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [{ "title": "Literature", "width": 1440, "height": 920, "minWidth": 1024, "minHeight": 700 }],
    "security": { "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:41731; img-src 'self' asset: http://127.0.0.1:41731 blob: data:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:" }
  },
  "bundle": { "active": true, "targets": "app", "macOS": { "minimumSystemVersion": "11.0" } }
}
